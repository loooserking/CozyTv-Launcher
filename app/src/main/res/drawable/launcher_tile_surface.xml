<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/launcher_elevated" />
            <stroke android:width="2dp" android:color="@color/launcher_accent" />
            <corners android:radius="22dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/launcher_tile" />
            <stroke android:width="1dp" android:color="@color/launcher_hairline" />
            <corners android:radius="22dp" />
        </shape>
    </item>
</selector>